#!/bin/bash
# b3ehive command line: compete, doctor, sync, lint, check.
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")")/.." && pwd)"
VERSION="$(cat "${ROOT_DIR}/VERSION")"
SKILLS=(compete-cron-builder execution-cron-builder learn-cron-builder optimization-cron-builder looper-cron-builder)

usage() {
  cat <<USAGE
b3ehive ${VERSION}

  b3ehive compete --question-type TYPE [--mock] "task" [compete options]
      Run a proposal competition. The runner comes from B3EHIVE_AGENT_RUNNER;
      --mock runs a dry competition.
  b3ehive doctor [--repo PATH]...
      Compare installed skills with this checkout; flag stale controllers.
  b3ehive sync     Sync core, loop, and the Codex plugin package.
  b3ehive lint     Structure and lexicon lint for the five skills.
  b3ehive check    Every repository check.
USAGE
}

digest() {
  (cd "$1" && find . -type f ! -name .b3ehive-version ! -name .DS_Store -print0 | LC_ALL=C sort -z \
    | xargs -0 shasum -a 256 | shasum -a 256 | cut -c1-16)
}

cmd_compete() {
  local args=() task="" runner=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --mock) runner=(--runner mock); shift ;;
      --*) args+=("$1" "$2"); shift 2 ;;
      *) task="$1"; shift ;;
    esac
  done
  [[ -n "$task" ]] || { usage >&2; exit 2; }
  local out="${B3EHIVE_OUTPUT:-competition-runs/$(date +%Y%m%d-%H%M%S)}"
  python3 "${ROOT_DIR}/compete-cron-builder/scripts/compete_cron_builder.py" \
    --task "$task" --output "$out" ${runner[@]+"${runner[@]}"} ${args[@]+"${args[@]}"}
}

cmd_doctor() {
  local repos=() status=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --repo) repos+=("$2"); shift 2 ;;
      *) usage >&2; exit 2 ;;
    esac
  done
  local roots=("$HOME/.codex/skills" "$HOME/.claude/skills" "$HOME/.cursor/skills" "${GROK_SKILLS_HOME:-$HOME/.grok/skills}"
               "${XDG_CONFIG_HOME:-$HOME/.config}/opencode/skills" "${OPENCLAW_SKILLS_HOME:-$HOME/.openclaw/skills}"
               "${HERMES_SKILLS_HOME:-$HOME/.hermes/skills}")
  for root in "${roots[@]}"; do
    for skill in "${SKILLS[@]}"; do
      local dst="${root}/${skill}"
      [[ -e "$dst" ]] || continue
      if [[ -L "$dst" ]]; then
        echo "ok      ${dst} -> $(readlink "$dst")"
      elif [[ -f "${dst}/.b3ehive-version" ]]; then
        local want have
        want="$(digest "${ROOT_DIR}/${skill}")"; have="$(grep '^digest=' "${dst}/.b3ehive-version" | cut -d= -f2)"
        if [[ "$want" == "$have" && "$(digest "$dst")" == "$want" ]]; then
          echo "ok      ${dst} (${VERSION})"
        else
          echo "STALE   ${dst}: reinstall with scripts/install_skills.sh"; status=1
        fi
      else
        echo "STALE   ${dst}: unstamped copy (v1 or manual); reinstall"; status=1
      fi
    done
  done
  for repo in ${repos[@]+"${repos[@]}"}; do
    local found=0
    while IFS= read -r file; do
      found=1
      if grep -q "b3ehive_skill_version=${VERSION}\|\"b3ehive_skill_version\": *\"${VERSION}\"" "$file"; then
        echo "ok      ${file}"
      else
        echo "STALE   ${file}: generated by another skill version; regenerate the controller"; status=1
      fi
    done < <(grep -rl "b3ehive_skill_version" "${repo}/.cron" "${repo}/.ops" 2>/dev/null || true)
    if [[ $found -eq 0 && ( -d "${repo}/.cron" || -d "${repo}/.ops" ) ]]; then
      echo "STALE   ${repo}: controller has no b3ehive_skill_version stamp (generated before v2)"; status=1
    fi
  done
  return $status
}

case "${1:-}" in
  compete) shift; cmd_compete "$@" ;;
  doctor) shift; cmd_doctor "$@" ;;
  sync) "${ROOT_DIR}/scripts/sync_core.sh"; "${ROOT_DIR}/scripts/sync_loop.sh"; "${ROOT_DIR}/scripts/sync_codex_plugin.sh" ;;
  lint) python3 "${ROOT_DIR}/scripts/lint_skills.py" ;;
  check) "${ROOT_DIR}/scripts/check_all.sh" ;;
  -h|--help|help|"") usage ;;
  *) echo "Unknown command: $1" >&2; usage >&2; exit 2 ;;
esac
