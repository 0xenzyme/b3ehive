{
  "name": "b3ehive",
  "slug": "b3ehive",
  "displayName": "b3ehive - Five Swarm Algorithms",
  "version": "1.4.0",
  "description": "A hive of five Codex, Claude Code, opencode, OpenClaw, and Hermes compatible agent swarm skills: debating, execution, research, optimization, and migration cron builders.",
  "author": "weiyangzen",
  "license": "MIT",
  "homepage": "https://github.com/weiyangzen/b3ehive",
  "repository": {
    "type": "git",
    "url": "https://github.com/weiyangzen/b3ehive.git"
  },
  "bugs": {
    "url": "https://github.com/weiyangzen/b3ehive/issues"
  },
  "keywords": [
    "openclaw",
    "codex",
    "claude-code",
    "opencode",
    "hermes",
    "skill",
    "multi-agent",
    "competition",
    "code-generation",
    "feynman",
    "collaboration",
    "swarm-intelligence",
    "cron-builder",
    "migration",
    "research",
    "optimization"
  ],
  "engines": {
    "openclaw": ">=2026.2.0"
  },
  "bin": {
    "b3ehive": "./bin/b3ehive"
  },
  "files": [
    "bin/",
    "scripts/",
    "templates/",
    "debating-cron-builder/",
    "execution-cron-builder/",
    "research-cron-builder/",
    "optimization-cron-builder/",
    "migration-cron-builder/",
    "docs/",
    "SKILL.md",
    "README.md",
    "LICENSE"
  ],
  "openclaw": {
    "entry": "SKILL.md",
    "emoji": "🐝",
    "category": "development",
    "requires": {
      "agents": [
        "coding"
      ],
      "models": [
        "openai-proxy/gpt-5.3-codex"
      ]
    }
  },
  "codex": {
    "skills": [
      "debating-cron-builder",
      "execution-cron-builder",
      "research-cron-builder",
      "optimization-cron-builder",
      "migration-cron-builder"
    ],
    "installRoot": "~/.codex/skills"
  },
  "claudeCode": {
    "skills": [
      "debating-cron-builder",
      "execution-cron-builder",
      "research-cron-builder",
      "optimization-cron-builder",
      "migration-cron-builder"
    ],
    "installRoot": "~/.claude/skills"
  },
  "opencode": {
    "skills": [
      "debating-cron-builder",
      "execution-cron-builder",
      "research-cron-builder",
      "optimization-cron-builder",
      "migration-cron-builder"
    ],
    "installRoot": "~/.config/opencode/skills"
  },
  "hermes": {
    "skills": [
      "debating-cron-builder",
      "execution-cron-builder",
      "research-cron-builder",
      "optimization-cron-builder",
      "migration-cron-builder"
    ],
    "installRoot": "~/.hermes/skills"
  }
}
